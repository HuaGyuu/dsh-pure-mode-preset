{
  "name": "@local/dsh-pure-mode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pure Mode: a DeepSeek Harness agent preset that sends ONLY user and assistant messages - no system prompt, no tools, no runtime context, no injected messages.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "pure-mode",
    "no-context"
  ],
  "license": "MIT",
  "author": "HuaGyuu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuaGyuu/dsh-pure-mode-preset.git"
  },
  "homepage": "https://github.com/HuaGyuu/dsh-pure-mode-preset#readme",
  "bugs": {
    "url": "https://github.com/HuaGyuu/dsh-pure-mode-preset/issues"
  },
  "exports": {
    ".": "./pure.js",
    "./host": "./host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "pure.js",
    "host.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
